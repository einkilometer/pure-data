0 80 282 [
[(The table is indexed from 1 to 120 so that 1 gives a true)]
[(zero out and 120 gives 10 \050a 20 dB boost.\051 The extra 20 dB)]
[(are for headroom.)]
] 14 -0 0 0 false DrawText
grestore
